# ============================================================
# hang. — Environment Variables Template
# Copy this file to apps/api/.env and fill in all values.
# NEVER commit .env files with real secrets to the repository.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/hang_dev

# ── Redis (Upstash serverless or local) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── Twilio (SMS OTP) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── APNs (Apple Push Notifications) ──────────────────────────
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_PATH=./apns-key.p8
APNS_BUNDLE_ID=com.hang.app
APNS_ENV=sandbox                       # sandbox | production

# ── JWT / Session ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Frontend (Expo) ─────────────────────────────────────────
# These go in apps/mobile/.env (EXPO_PUBLIC_ prefix is required)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
