{
  "name": "@hang/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "pnpm exec prisma migrate deploy",
    "db:migrate:dev": "pnpm exec prisma migrate dev",
    "db:generate": "pnpm exec prisma generate",
    "db:seed": "pnpm exec tsx prisma/seed.ts",
    "db:seed-demo": "pnpm exec tsx prisma/seed-demo.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hang/shared": "workspace:*",
    "@prisma/client": "^5.14.0",
    "apn": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "bullmq": "^5.7.0",
    "fastify": "^4.27.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "twilio": "^5.2.0",
    "zod": "^3.23.8",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/apn": "^2.1.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.2",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  }
}
