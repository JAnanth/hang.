generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone          String    @unique @db.VarChar(20)
  name           String    @db.VarChar(100)
  username       String?   @unique @db.VarChar(50)
  avatarUrl      String?   @map("avatar_url")
  berkeleyEmail  String?   @unique @map("berkeley_email") @db.VarChar(255)
  isVerified     Boolean   @default(false) @map("is_verified")
  pushToken      String?   @map("push_token")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()

  groupMemberships      GroupMember[]
  createdGroups         Group[]              @relation("GroupCreator")
  createdEvents         Event[]              @relation("EventCreator")
  rsvps                 Rsvp[]
  comments              EventComment[]
  authSessions          AuthSession[]
  notificationPrefs     NotificationPreference[]
  connectionsAsA        UserConnection[]     @relation("ConnectionA")
  connectionsAsB        UserConnection[]     @relation("ConnectionB")
  timeVotes             EventTimeVote[]

  @@map("users")
}

model Group {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  type        String    @db.VarChar(20)
  orgSlug     String?   @unique @map("org_slug") @db.VarChar(100)
  inviteCode  String    @unique @map("invite_code") @db.VarChar(12)
  createdBy   String?   @map("created_by") @db.Uuid
  avatarUrl   String?   @map("avatar_url")
  memberCount Int       @default(0) @map("member_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  creator              User?                  @relation("GroupCreator", fields: [createdBy], references: [id])
  members              GroupMember[]
  eventGroups          EventGroup[]
  notificationPrefs    NotificationPreference[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member") @db.VarChar(20)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId], name: "idx_group_members_user")
  @@index([groupId], name: "idx_group_members_group")
  @@map("group_members")
}

model UserConnection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userA     String   @map("user_a") @db.Uuid
  userB     String   @map("user_b") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userARelation User @relation("ConnectionA", fields: [userA], references: [id], onDelete: Cascade)
  userBRelation User @relation("ConnectionB", fields: [userB], references: [id], onDelete: Cascade)

  @@unique([userA, userB])
  @@index([userA], name: "idx_user_connections_a")
  @@index([userB], name: "idx_user_connections_b")
  @@map("user_connections")
}

model Event {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String    @db.VarChar(200)
  description   String?
  location      String?
  type          String    @db.VarChar(20)
  status        String    @default("active") @db.VarChar(20)
  createdBy     String    @map("created_by") @db.Uuid
  friendsOnly   Boolean   @default(false) @map("friends_only")
  quickAddCap   Int       @default(10) @map("quick_add_cap")
  confirmedTime DateTime? @map("confirmed_time") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  creator     User               @relation("EventCreator", fields: [createdBy], references: [id])
  eventGroups EventGroup[]
  timeOptions EventTimeOption[]
  rsvps       Rsvp[]
  comments    EventComment[]

  @@index([createdBy], name: "idx_events_created_by")
  @@map("events")
}

model EventGroup {
  eventId String @map("event_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([eventId, groupId])
  @@index([groupId], name: "idx_event_groups_group")
  @@map("event_groups")
}

model EventTimeOption {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  proposedTime DateTime @map("proposed_time") @db.Timestamptz()
  voteCount    Int      @default(0) @map("vote_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  event Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes EventTimeVote[]

  @@map("event_time_options")
}

model EventTimeVote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timeOptionId String   @map("time_option_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  timeOption EventTimeOption @relation(fields: [timeOptionId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([timeOptionId, userId])
  @@map("event_time_votes")
}

model Rsvp {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  status    String    @db.VarChar(20)
  seenAt    DateTime? @map("seen_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId], name: "idx_rsvps_event")
  @@index([userId], name: "idx_rsvps_user")
  @@map("rsvps")
}

model EventComment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  body      String    @db.VarChar(280)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId], name: "idx_event_comments_event")
  @@map("event_comments")
}

model NotificationPreference {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid
  level   String @default("all") @db.VarChar(20)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("notification_preferences")
}

model OtpSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @db.VarChar(20)
  otpHash   String   @map("otp_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("otp_sessions")
}

model AuthSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  deviceInfo String?  @map("device_info")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], name: "idx_auth_sessions_token")
  @@map("auth_sessions")
}
